# ─── Meridian Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it's in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key for AI extraction
ANTHROPIC_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────

# CSRF token signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MERIDIAN_CSRF_SECRET=

# Comma-separated list of origins allowed by CORS.
# In production, set this to your frontend's exact origin.
# Example: MERIDIAN_ALLOWED_ORIGINS=https://meridian.yourdomain.com
# Default (if unset): localhost only — safe for local dev.
MERIDIAN_ALLOWED_ORIGINS=

# Set to "production" to:
#   - Disable /docs and /openapi.json endpoints
#   - Enforce HTTPS-only cookies
MERIDIAN_ENV=development

# ── Pub/Sub push (Phase 3 — leave empty for polling-only mode) ────────────────

# Your full webhook URL — used to verify the OIDC token audience.
# Example: https://meridian.yourdomain.com/webhook/gmail
PUBSUB_AUDIENCE=

# Google Cloud Pub/Sub topic name.
# Example: projects/my-project-id/topics/meridian-gmail
PUBSUB_TOPIC=

# ── Optional ──────────────────────────────────────────────────────────────────

# SQLite database path (default: meridian.db in project root)
MERIDIAN_DB_PATH=meridian.db

# Max request body size in bytes (default: 524288 = 512 KB)
MERIDIAN_MAX_BODY_BYTES=524288

# Server port (default: 8000)
PORT=8000
